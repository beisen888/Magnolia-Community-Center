{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ],
  "functions": {
    "api/remind.js": {
      "includeFiles": "config.js"
    },
    "api/publish.js": {
      "includeFiles": "config.js"
    }
  },
  "crons": [
    {
      "path": "/api/remind",
      "schedule": "0 23 * * *"
    }
  ]
}